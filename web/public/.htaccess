# Apache rules for hosting the site on cPanel (GoDaddy).

# Single-page app: any path that is not a real file or folder (e.g.
# /who-we-are, /contact) is answered with index.html, so deep links and
# page refreshes work and return 200 rather than 404.
Options -MultiViews
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Built JS/CSS filenames change on every release, so they can be cached for
# a long time; index.html must always be re-checked to pick up new releases.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|svg|webp)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
